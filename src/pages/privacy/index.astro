---
import Base from '../../layouts/Base.astro';
import { SITE_NAME } from '../../lib/site';
---
<Base title={`Privacy | ${SITE_NAME}`} description={`Privacy policy for ${SITE_NAME}.`}>
  <section>
    <h1>Privacy</h1>
    <p>This site does not ask for or store personal information. We may use privacy-friendly analytics and, later, display advertising. If we do, those providers may use cookies, and this page will list them.</p>
    <p>Links to tire retailers may be affiliate links. As an Amazon Associate we earn from qualifying purchases.</p>
  </section>
</Base>
