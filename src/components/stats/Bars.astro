---
// A table that doubles as a horizontal bar chart. Real table markup, so screen readers and scrapers get the numbers.
interface Row { label: string; value: number; se?: number; extra?: string; ok?: boolean }
interface Props { id: string; caption: string; rows: Row[]; valueLabel?: string; extraLabel?: string; max?: number; highlight?: string[]; format?: 'pct' | 'count'; note?: string }
const { id, caption, rows, valueLabel = 'Share', extraLabel, highlight = [], format = 'pct', note } = Astro.props;
const max = Astro.props.max ?? Math.max(...rows.map((r) => r.value), 1);
const fmt = (v: number) => (format === 'pct' ? `${v.toFixed(1)}%` : Math.round(v).toLocaleString('en-US'));
const fmtSe = (se: number) => (format === 'pct' ? (1.96 * se).toFixed(1) : Math.round(1.96 * se).toLocaleString('en-US'));
---
<figure class="bars" id={id}>
  <figcaption><b>{caption}</b> <a href={`#${id}`} class="copy-link st-small" data-copy-anchor={id}>Link</a></figcaption>
  <div class="st-wrap">
    <table>
      <thead><tr><th scope="col">Group</th><th scope="col">{valueLabel}</th>{extraLabel && <th scope="col">{extraLabel}</th>}</tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr class={highlight.includes(r.label) ? 'hl' : undefined}>
            <th scope="row" class="bar-label">{r.label}</th>
            <td class="bar-cell">
              {r.ok === false ? <span class="st-muted st-small">Too few cases for a reliable estimate</span> : <>
              <span class="bar" style={`width:${Math.max(1, (r.value / max) * 100).toFixed(1)}%`}></span>
              <span class="bar-val">{fmt(r.value)}{r.se !== undefined && <span class="st-muted st-small"> ±{fmtSe(r.se)}</span>}</span></>}
            </td>
            {extraLabel && <td>{r.extra}</td>}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {note && <p class="st-small st-muted">{note}</p>}
</figure>
